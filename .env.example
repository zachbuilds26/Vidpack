# --- vidpack env ---
# YouTube Data API v3 key (Google Cloud Console -> YouTube Data API v3)
YOUTUBE_API_KEY=

# Google Gemini API key (free tier). If empty, vidpack tries Groq, else rules-only.
GEMINI_API_KEY=

# Groq API key (free tier, OpenAI-compatible): https://console.groq.com/keys
# Used when GEMINI_API_KEY is empty.
GROQ_API_KEY=

# Optional: extra Groq keys for automatic rotation when one is rate-limited
# or hits its daily quota (used in priority order).
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional
# DB_PATH=                       # where the SQLite library lives
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# RESEARCH_MAX_VIDEOS=30         # videos analysed per research run
# YOUTUBE_QUOTA_DAILY_LIMIT=10000
# APP_HOST=127.0.0.1
# APP_PORT=8000